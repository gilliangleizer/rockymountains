# Claude API key — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Twilio Auth Token — used to validate X-Twilio-Signature on webhooks
TWILIO_AUTH_TOKEN=

# Notion internal integration token — https://www.notion.so/my-integrations
# Create an integration, then share the Shopping Lists page with it
NOTION_TOKEN=

# Optional: comma-separated allowed WhatsApp senders, with or without the whatsapp: prefix
ALLOWED_NUMBERS=

# Optional: override default port (5001)
PORT=5001
