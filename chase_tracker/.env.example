# Plaid credentials — get from https://dashboard.plaid.com/signup (free)
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
PLAID_ENV=development

# Chase card access tokens — filled in automatically by setup.py
PLAID_ACCESS_TOKEN_1=
PLAID_ACCESS_TOKEN_2=

# Friendly names for each card (shown in the sheet)
CARD_1_NAME=Chase Sapphire
CARD_2_NAME=Chase Freedom

# Google Sheet ID — the long ID in the sheet's URL
# e.g. https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# How many days back to fetch (default: 90)
DAYS_TO_FETCH=90
